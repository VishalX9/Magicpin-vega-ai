# Bot LLM (optional — without it the bot runs on deterministic templates)
LLM_PROVIDER=groq            # groq | anthropic | openai | deepseek | openrouter | gemini | ollama
LLM_API_KEY=                 # or GROQ_API_KEY=...
LLM_MODEL=                   # optional; groq default: llama-3.3-70b-versatile
LLM_TIMEOUT=6                # seconds per LLM call
STRICT_EXPIRY=0              # 1 = drop triggers past expires_at even if the judge lists them
TEAM_NAME=Team Vera
TEAM_MEMBERS=Sayantan
CONTACT_EMAIL=
